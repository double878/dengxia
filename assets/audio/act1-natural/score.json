  "lines": [
    {
      "line_id": "opening-01",
      "role_id": "xiaoqing",
      "role_name": "小青",
      "text": "姐姐，你看，湖上人来人往，可比峨眉热闹多啦！",
      "start_ms": 120,
      "end_ms": 5449,
      "delivery": "speech"
    },
    {
      "line_id": "opening-02",
      "role_id": "baisuzhen",
      "role_name": "白素贞",
      "text": "青妹，你看，柳色映着湖波，果然是好风光。",
      "start_ms": 5749,
      "end_ms": 10602,
      "delivery": "speech"
    },
    {
      "line_id": "opening-03",
      "role_id": "xiaoqing",
      "role_name": "小青",
      "text": "哎呀，雨来了！那边的君子，倒有一把好伞。",
      "start_ms": 10902,
      "end_ms": 15755,
      "delivery": "speech"
    },
    {
      "line_id": "opening-04",
      "role_id": "baisuzhen",
      "role_name": "白素贞",
      "text": "待我上前，借问一声。",
      "start_ms": 16055,
      "end_ms": 18725,
      "delivery": "speech"
    },
    {
      "line_id": "borrow-1",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "湖边风急雨丝长，娘子莫教湿衣裳。",
      "start_ms": 25025,
      "end_ms": 36275,
      "delivery": "singing"
    },
    {
      "line_id": "borrow-2",
      "role_id": "baisuzhen",
      "role_name": "白素贞",
      "text": "君子相怜情意厚，怎教你独受风凉。",
      "start_ms": 36275,
      "end_ms": 47575,
      "delivery": "singing"
    },
    {
      "line_id": "borrow-3",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "些小风雨何须讲，请接此伞莫彷徨。",
      "start_ms": 47575,
      "end_ms": 56377,
      "delivery": "singing"
    },
    {
      "line_id": "return-01",
      "role_id": "baisuzhen",
      "role_name": "白素贞",
      "text": "君子，雨住了。这伞，奉还。",
      "start_ms": 74977,
      "end_ms": 78158,
      "delivery": "speech"
    },
    {
      "line_id": "return-02",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "些小之事，何劳娘子专程回来。",
      "start_ms": 78458,
      "end_ms": 82081,
      "delivery": "speech"
    },
    {
      "line_id": "return-03",
      "role_id": "baisuzhen",
      "role_name": "白素贞",
      "text": "伞可以托青儿送来，谢意……还是我亲口说的好。",
      "start_ms": 82381,
      "end_ms": 87710,
      "delivery": "speech"
    },
    {
      "line_id": "return-04",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "娘子言重了。",
      "start_ms": 88010,
      "end_ms": 89995,
      "delivery": "speech"
    },
    {
      "line_id": "return-05",
      "role_id": "baisuzhen",
      "role_name": "白素贞",
      "text": "还未请教，君子高姓？",
      "start_ms": 90295,
      "end_ms": 92965,
      "delivery": "speech"
    },
    {
      "line_id": "return-06",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "小生姓许，名仙。",
      "start_ms": 93265,
      "end_ms": 95460,
      "delivery": "speech"
    },
    {
      "line_id": "return-07",
      "role_id": "baisuzhen",
      "role_name": "白素贞",
      "text": "小女子白素贞。许君子，明日若再游湖，可还认得我么？",
      "start_ms": 95760,
      "end_ms": 101797,
      "delivery": "speech"
    },
    {
      "line_id": "return-08",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "白小姐……小生怎会不认得。",
      "start_ms": 102097,
      "end_ms": 105371,
      "delivery": "speech"
    },
    {
      "line_id": "return-09",
      "role_id": "baisuzhen",
      "role_name": "白素贞",
      "text": "那就……莫忘了。",
      "start_ms": 105671,
      "end_ms": 107761,
      "delivery": "speech"
    }
  ],
