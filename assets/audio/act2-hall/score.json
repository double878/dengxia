{
  "audio_version": "act2-hall-vocals-only-999dcca862f8",
  "scene_id": "wine_transformation",
  "main_path": "res://assets/audio/act2-hall/main.wav",
  "duration_ms": 69517,
  "lines": [
    {
      "line_id": "xu-offer",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "娘子，今日端阳，陪我饮一杯吧。",
      "start_ms": 500,
      "end_ms": 4262,
      "start_frame": 24000,
      "end_frame": 204559,
      "delivery": "speech",
      "seed": 2026101300
    },
    {
      "line_id": "qing-stop",
      "role_id": "xiaoqing",
      "role_name": "小青",
      "text": "官人，姐姐不善饮酒，莫再劝了。",
      "start_ms": 4612,
      "end_ms": 8373,
      "start_frame": 221359,
      "end_frame": 401918,
      "delivery": "speech",
      "seed": 2026101301
    },
    {
      "line_id": "xu-send",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "我想与娘子单独说说话，小青，你去多买些酒菜吧。",
      "start_ms": 8723,
      "end_ms": 14389,
      "start_frame": 418718,
      "end_frame": 690671,
      "delivery": "speech",
      "seed": 2026101302
    },
    {
      "line_id": "bai-allow",
      "role_id": "baisuzhen",
      "role_name": "白素贞",
      "text": "小青，你就去吧。",
      "start_ms": 14739,
      "end_ms": 16933,
      "start_frame": 707471,
      "end_frame": 812797,
      "delivery": "speech",
      "seed": 2026101303
    },
    {
      "line_id": "qing-reply",
      "role_id": "xiaoqing",
      "role_name": "小青",
      "text": "好吧。",
      "start_ms": 17283,
      "end_ms": 19269,
      "start_frame": 829597,
      "end_frame": 924892,
      "delivery": "speech",
      "seed": 2026101304
    },
    {
      "line_id": "bai-unwell",
      "role_id": "baisuzhen",
      "role_name": "白素贞",
      "text": "官人，我身子有些不适。",
      "start_ms": 61969,
      "end_ms": 64871,
      "start_frame": 2974492,
      "end_frame": 3113812,
      "delivery": "speech",
      "seed": 2026101305
    },
    {
      "line_id": "xu-medicine",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "娘子稍候，我去取些药来。",
      "start_ms": 65221,
      "end_ms": 68367,
      "start_frame": 3130612,
      "end_frame": 3281635,
      "delivery": "speech",
      "seed": 2026101306
    }
  ],
  "duet": [
    {
      "line_id": "duet-1",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "端阳佳节共举杯，愿与娘子长相随。",
      "start_ms": 20119,
      "end_ms": 31357,
      "start_frame": 965692,
      "end_frame": 1505138,
      "delivery": "singing",
      "seed": 2026101401
    },
    {
      "line_id": "duet-2",
      "role_id": "baisuzhen",
      "role_name": "白素贞",
      "text": "官人盛意心领会，只怕薄酒也难支。",
      "start_ms": 31369,
      "end_ms": 42653,
      "start_frame": 1505692,
      "end_frame": 2047367,
      "delivery": "singing",
      "seed": 2026101402
    },
    {
      "line_id": "duet-3",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "只此一杯添欢喜，娘子莫再把杯推。",
      "start_ms": 42669,
      "end_ms": 51121,
      "start_frame": 2048092,
      "end_frame": 2453791,
      "delivery": "singing",
      "seed": 2026101403
    },
    {
      "line_id": "duet-4",
      "role_id": "baisuzhen",
      "role_name": "白素贞",
      "text": "既是官人再三劝，且饮一杯谢情意。",
      "start_ms": 51119,
      "end_ms": 61103,
      "start_frame": 2453692,
      "end_frame": 2932952,
      "delivery": "singing",
      "seed": 2026101404
    }
  ],
