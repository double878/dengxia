  "lines": [
    {
      "line_id": "dialogue-01",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "许施主。你家娘子，并非凡人。贫僧今日，正是为此而来。",
      "delivery": "speech",
      "start_frame": 12000,
      "end_frame": 475212,
      "start_ms": 250,
      "end_ms": 9900
    },
    {
      "line_id": "dialogue-02",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "我娘子心地善良，怎会是妖？",
      "delivery": "speech",
      "start_frame": 516012,
      "end_frame": 809691,
      "start_ms": 10750,
      "end_ms": 16869
    },
    {
      "line_id": "dialogue-03",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "人妖有别。莫被她的温情，蒙蔽了双眼。",
      "delivery": "speech",
      "start_frame": 850491,
      "end_frame": 1172591,
      "start_ms": 17719,
      "end_ms": 24429
    },
    {
      "line_id": "dialogue-04",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "大师这样说，可有凭据？",
      "delivery": "speech",
      "start_frame": 1213391,
      "end_frame": 1478649,
      "start_ms": 25279,
      "end_ms": 30805
    },
    {
      "line_id": "dialogue-05",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "端午将至。你劝她，喝杯雄黄酒。是人是妖。一试，便知。",
      "delivery": "speech",
      "start_frame": 1519449,
      "end_frame": 2066245,
      "start_ms": 31655,
      "end_ms": 43047
    },
    {
      "line_id": "dialogue-06",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "这，我便劝她一杯。若是无事，还请大师莫再疑她。",
      "delivery": "speech",
      "start_frame": 2107045,
      "end_frame": 2604808,
      "start_ms": 43897,
      "end_ms": 54267
    }
  ],
