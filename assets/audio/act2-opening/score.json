  "lines": [
    {
      "line_id": "dialogue-01",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "许施主。你家娘子，并非凡人。贫僧今日，正是为此而来。",
      "delivery": "speech",
      "start_frame": 12000,
      "end_frame": 425280,
      "start_ms": 250,
      "end_ms": 8860
    },
    {
      "line_id": "dialogue-02",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "我娘子心地善良，怎会是妖？",
      "delivery": "speech",
      "start_frame": 466080,
      "end_frame": 628806,
      "start_ms": 9710,
      "end_ms": 13100
    },
    {
      "line_id": "dialogue-03",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "人妖有别。莫被她的温情，蒙蔽了双眼。",
      "delivery": "speech",
      "start_frame": 669606,
      "end_frame": 927366,
      "start_ms": 13950,
      "end_ms": 19320
    },
    {
      "line_id": "dialogue-04",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "大师这样说，可有凭据？",
      "delivery": "speech",
      "start_frame": 968166,
      "end_frame": 1107486,
      "start_ms": 20170,
      "end_ms": 23073
    },
    {
      "line_id": "dialogue-05",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "端午将至。你劝她，喝杯雄黄酒。是人是妖。一试，便知。",
      "delivery": "speech",
      "start_frame": 1148286,
      "end_frame": 1704094,
      "start_ms": 23923,
      "end_ms": 35502
    },
    {
      "line_id": "dialogue-06",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "这，我便劝她一杯。若是无事，还请大师莫再疑她。",
      "delivery": "speech",
      "start_frame": 1744894,
      "end_frame": 2011831,
      "start_ms": 36352,
      "end_ms": 41913
    }
  ],
