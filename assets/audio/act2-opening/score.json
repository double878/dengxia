      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "我那娘子乃是贤德之人，",
      "delivery": "original",
      "source_id": "video-2",
      "start_frame": 2151168,
      "end_frame": 2376768,
      "start_ms": 44816,
      "end_ms": 49516
    },
    {
      "line_id": "act2_original_10",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "怎说是蛇妖所化？",
      "delivery": "original",
      "source_id": "video-2",
      "start_frame": 2376768,
      "end_frame": 2487168,
      "start_ms": 49516,
      "end_ms": 51816
    },
    {
      "line_id": "act2_original_11",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "师父讲话太无理了！",
