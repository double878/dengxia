  "lines": [
    {
      "line_id": "act2_opening_fahai_01",
      "role_id": "fahai",
      "text": "许施主，贫僧查明，你家娘子是蛇妖所化。",
      "seed": 2026101200,
      "role_name": "法海",
      "start_ms": 500,
      "end_ms": 5214,
      "delivery": "speech"
    },
    {
      "line_id": "act2_opening_xuxian_01",
      "role_id": "xuxian",
      "text": "我娘子心地善良，怎会是妖？",
      "seed": 2026101201,
      "role_name": "许仙",
      "start_ms": 5564,
      "end_ms": 8954,
      "delivery": "speech"
    },
    {
      "line_id": "act2_opening_fahai_02",
      "role_id": "fahai",
      "text": "人妖有别，莫被她的温情蒙蔽。",
      "seed": 2026101202,
      "role_name": "法海",
      "start_ms": 9304,
      "end_ms": 12926,
      "delivery": "speech"
    },
    {
      "line_id": "act2_opening_xuxian_02",
      "role_id": "xuxian",
      "text": "大师这样说，可有凭据？",
      "seed": 2026101203,
      "role_name": "许仙",
      "start_ms": 13276,
      "end_ms": 16179,
      "delivery": "speech"
    },
    {
      "line_id": "act2_opening_fahai_03",
      "role_id": "fahai",
      "text": "端午将至，你劝她喝杯雄黄酒。是人是妖，一试便知。",
      "seed": 2026101204,
      "role_name": "法海",
      "start_ms": 16529,
      "end_ms": 22334,
      "delivery": "speech"
    },
    {
      "line_id": "act2_opening_xuxian_03",
      "role_id": "xuxian",
      "text": "这……我便劝她一杯。若是无事，还请大师莫再疑她。",
      "seed": 2026101205,
      "generation_text": "这，我便劝她一杯。若是无事，还请大师莫再疑她。",
      "generation_note": "Same words, use short comma pause instead of ellipsis; one bounded content revision",
      "role_name": "许仙",
      "start_ms": 23534,
      "end_ms": 29095,
      "delivery": "speech"
    }
  ],
