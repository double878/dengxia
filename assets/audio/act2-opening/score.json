  "lines": [
    {
      "line_id": "sung-01",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "许施主不请到此地。",
      "delivery": "original",
      "start_frame": 186284,
      "end_frame": 946106,
      "start_ms": 3881,
      "end_ms": 19711
    },
    {
      "line_id": "sung-02",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "原来金山寺老禅师。",
      "delivery": "singing",
      "start_frame": 1056261,
      "end_frame": 1819333,
      "start_ms": 22005,
      "end_ms": 37903
    },
    {
      "line_id": "fahai-original-01",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "可记得保和堂里点化你",
      "delivery": "original",
      "start_frame": 1922385,
      "end_frame": 2462385,
      "start_ms": 40050,
      "end_ms": 51300
    },
    {
      "line_id": "fahai-original-02",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "说你被那妖魔缠",
      "delivery": "original",
      "start_frame": 2462385,
      "end_frame": 2822385,
      "start_ms": 51300,
      "end_ms": 58800
    },
    {
      "line_id": "fahai-original-03",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "你妻本是妖蛇变",
      "delivery": "original",
      "start_frame": 2822385,
      "end_frame": 3146385,
      "start_ms": 58800,
      "end_ms": 65550
    },
    {
      "line_id": "fahai-original-04",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "变化人形在你的身边",
      "delivery": "original",
      "start_frame": 3146385,
      "end_frame": 3530385,
      "start_ms": 65550,
      "end_ms": 73550
    },
    {
      "line_id": "fahai-original-05",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "五月端阳可曾应验",
      "delivery": "original",
      "start_frame": 3530385,
      "end_frame": 3854385,
      "start_ms": 73550,
      "end_ms": 80300
    },
    {
      "line_id": "fahai-original-06",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "现出原形在你的身边",
      "delivery": "original",
      "start_frame": 3854385,
      "end_frame": 4290897,
      "start_ms": 80300,
      "end_ms": 89394
    },
    {
      "line_id": "sung-03",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "此事容我归家思量。",
      "delivery": "singing",
      "start_frame": 4295983,
      "end_frame": 5056913,
      "start_ms": 89500,
      "end_ms": 105352
    }
  ],
