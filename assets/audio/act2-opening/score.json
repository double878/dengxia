  "audio_version": "act2-natural-opening-fa10139bd845",
  "stage_id": 2,
  "scene_id": "fahai_advice",
  "main_path": "res://assets/audio/act2-opening/main.wav",
  "intro_path": "res://assets/audio/act2-opening/intro.wav",
  "intro_once": true,
