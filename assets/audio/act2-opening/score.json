      "line_id": "act2_original_01",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "许施主，请了。",
      "delivery": "original",
      "source_id": "video-1",
      "start_frame": 0,
      "end_frame": 276000,
      "start_ms": 0,
      "end_ms": 5750
    },
    {
      "line_id": "act2_original_02",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "啊，你是？",
      "delivery": "voice_converted",
      "source_id": "video-1",
      "start_frame": 276000,
      "end_frame": 468000,
      "start_ms": 5750,
      "end_ms": 9750
    },
    {
      "line_id": "act2_original_03",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "老僧法海。",
      "delivery": "original",
      "source_id": "video-1",
      "start_frame": 468000,
      "end_frame": 636000,
      "start_ms": 9750,
      "end_ms": 13250
    },
    {
      "line_id": "act2_original_04",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "施主可还记得？",
      "delivery": "original",
      "source_id": "video-1",
      "start_frame": 636000,
      "end_frame": 864000,
      "start_ms": 13250,
      "end_ms": 18000
    },
    {
      "line_id": "act2_original_05",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "哦，原来你是金山寺的老禅师啊。",
      "delivery": "voice_converted",
      "source_id": "video-1",
      "start_frame": 864000,
      "end_frame": 1351808,
      "start_ms": 18000,
      "end_ms": 28163
    },
    {
      "line_id": "act2_original_06",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "可记得保和堂里点化你",
      "delivery": "original",
      "source_id": "video-2",
      "start_frame": 1351808,
      "end_frame": 1891808,
      "start_ms": 28163,
      "end_ms": 39413
    },
    {
      "line_id": "act2_original_07",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "说你被那妖魔缠",
      "delivery": "original",
      "source_id": "video-2",
      "start_frame": 1891808,
      "end_frame": 2251808,
      "start_ms": 39413,
      "end_ms": 46913
    },
    {
      "line_id": "act2_original_08",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "你妻本是妖蛇变",
      "delivery": "original",
      "source_id": "video-2",
      "start_frame": 2251808,
      "end_frame": 2575808,
      "start_ms": 46913,
      "end_ms": 53663
    },
    {
      "line_id": "act2_original_09",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "变化人形在你的身边",
      "delivery": "original",
      "source_id": "video-2",
      "start_frame": 2575808,
      "end_frame": 2959808,
      "start_ms": 53663,
      "end_ms": 61663
    },
    {
      "line_id": "act2_original_10",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "五月端阳可曾应验",
      "delivery": "original",
      "source_id": "video-2",
      "start_frame": 2959808,
      "end_frame": 3283808,
      "start_ms": 61663,
      "end_ms": 68413
    },
    {
      "line_id": "act2_original_11",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "现出原形在你的身边",
      "delivery": "original",
      "source_id": "video-2",
