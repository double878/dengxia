  "lines": [
    {
      "line_id": "dialogue-01",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "许施主。你家娘子，并非凡人。贫僧今日，正是为此而来。",
      "delivery": "speech",
      "start_frame": 12000,
      "end_frame": 415136,
      "start_ms": 250,
      "end_ms": 8649
    },
    {
      "line_id": "dialogue-02",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "我娘子心地善良，怎会是妖？",
      "delivery": "speech",
      "start_frame": 455936,
      "end_frame": 618662,
      "start_ms": 9499,
      "end_ms": 12889
    },
    {
      "line_id": "dialogue-03",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "人妖有别。莫被她的温情，蒙蔽了双眼。",
      "delivery": "speech",
      "start_frame": 659462,
      "end_frame": 922150,
      "start_ms": 13739,
      "end_ms": 19211
    },
    {
      "line_id": "dialogue-04",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "大师这样说，可有凭据？",
      "delivery": "speech",
      "start_frame": 962950,
      "end_frame": 1102270,
      "start_ms": 20061,
      "end_ms": 22964
    },
    {
      "line_id": "dialogue-05",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "端午将至。你劝她，喝杯雄黄酒。是人是妖。一试，便知。",
      "delivery": "speech",
      "start_frame": 1143070,
      "end_frame": 1592798,
      "start_ms": 23814,
      "end_ms": 33183
    },
    {
      "line_id": "dialogue-06",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "这，我便劝她一杯。若是无事，还请大师莫再疑她。",
      "delivery": "speech",
      "start_frame": 1633598,
      "end_frame": 1900535,
      "start_ms": 34033,
      "end_ms": 39594
    }
  ],
