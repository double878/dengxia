  "lines": [
    {
      "line_id": "dialogue-01",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "许施主。你家娘子，并非凡人。贫僧今日，正是为此而来。",
      "delivery": "speech",
      "start_frame": 12000,
      "end_frame": 475212,
      "start_ms": 250,
      "end_ms": 9900
    },
    {
      "line_id": "dialogue-02",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "我娘子心地善良，怎会是妖？",
      "delivery": "speech",
      "start_frame": 516012,
      "end_frame": 678738,
      "start_ms": 10750,
      "end_ms": 14140
    },
    {
      "line_id": "dialogue-03",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "人妖有别。莫被她的温情，蒙蔽了双眼。",
      "delivery": "speech",
      "start_frame": 719538,
      "end_frame": 1041638,
      "start_ms": 14990,
      "end_ms": 21701
    },
    {
      "line_id": "dialogue-04",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "大师这样说，可有凭据？",
      "delivery": "speech",
      "start_frame": 1082438,
      "end_frame": 1221758,
      "start_ms": 22551,
      "end_ms": 25453
    },
    {
      "line_id": "dialogue-05",
      "role_id": "fahai",
      "role_name": "法海",
      "text": "端午将至。你劝她，喝杯雄黄酒。是人是妖。一试，便知。",
      "delivery": "speech",
      "start_frame": 1262558,
      "end_frame": 1809354,
      "start_ms": 26303,
      "end_ms": 37695
    },
    {
      "line_id": "dialogue-06",
      "role_id": "xuxian",
      "role_name": "许仙",
      "text": "这，我便劝她一杯。若是无事，还请大师莫再疑她。",
      "delivery": "speech",
      "start_frame": 1850154,
      "end_frame": 2117091,
      "start_ms": 38545,
      "end_ms": 44106
    }
  ],
