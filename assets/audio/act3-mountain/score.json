    {
      "start_ms": 34500,
      "end_ms": 36300,
      "role_name": "鹿童",
      "text": "不要走！是你看剑！"
    },
    {
      "start_ms": 36500,
      "end_ms": 44400,
      "role_name": "白素贞",
      "text": "且慢动手，尊仙童。"
    },
    {
      "start_ms": 44500,
      "end_ms": 50400,
      "role_name": "白素贞",
      "text": "素贞还有一段下情。"
    },
